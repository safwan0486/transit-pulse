# Copy this file to .env  (cp .env.example .env)
# These are LOCAL DEVELOPMENT values only - never reuse them anywhere real.

# --- Data lake (SeaweedFS locally; real S3/GCS later). Must match infra/seaweedfs/s3.json ---
AWS_ACCESS_KEY_ID=transit
AWS_SECRET_ACCESS_KEY=transit-local-secret
AWS_DEFAULT_REGION=ap-southeast-1
LAKE_BUCKET=transit-lake

# --- Kafka ---
KAFKA_TOPIC_VEHICLE_POSITIONS=gtfs.vehicle_positions

# --- Feeds to ingest (comma separated, see ingestion/transit/feeds.py) ---
REALTIME_FEEDS=rapid-bus-kl,rapid-bus-mrtfeeder,ktmb
STATIC_FEEDS=rapid-bus-kl,rapid-bus-mrtfeeder,rapid-rail-kl,ktmb

# --- Producer ---
POLL_INTERVAL_SECONDS=30

# --- Bronze sink ---
SINK_BATCH_SIZE=5000
SINK_FLUSH_SECONDS=300

# --- Airflow web UI login ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Spark streaming (silver layer) ---
SPARK_TRIGGER_SECONDS=60
DEDUPE_WATERMARK=15 minutes


# --- Alerting: Discord or Slack incoming-webhook URL (leave empty to only log) ---
ALERT_WEBHOOK_URL=
